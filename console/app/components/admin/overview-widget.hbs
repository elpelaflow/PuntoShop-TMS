<div class="admin-dashboard-widget flex h-full flex-col overflow-hidden rounded-md border border-default bg-surface shadow-sm" ...attributes>
    <div class="border-b border-default px-3 py-2.5">
        <div class="text-xs font-bold uppercase text-primary">{{this.title}}</div>
        <div class="text-[11px] text-muted">Legacy overview widget</div>
    </div>

    <div class="grid flex-1 grid-cols-2 gap-2 p-3">
        {{#if this.error}}
            <div class="col-span-2 flex items-center justify-center text-xs font-medium text-state-danger-text">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="col-span-2 flex items-center justify-center"><Spinner /></div>
        {{else}}
            {{#each this.items as |item|}}
                <div class="rounded-md border border-subtle p-2">
                    <div class="truncate text-[10px] font-bold uppercase text-muted">{{item.label}}</div>
                    <div class="mt-1 text-xl font-bold text-primary">{{item.value}}</div>
                </div>
            {{/each}}
        {{/if}}
    </div>
</div>
