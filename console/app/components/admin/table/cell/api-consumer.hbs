{{! An identity cell for an API consumer: type icon, name, then the masked key / token and client address. }}
<div class="flex min-w-0 items-center gap-2 py-0.5" data-test-api-consumer-cell>
    <div
        class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border shadow-sm
            {{if
                @row.isThrottled
                'border-state-danger-border bg-state-danger-bg text-state-danger-text'
                'border-default bg-surface-subtle text-muted'
            }}"
        title={{@row.typeLabel}}
    >
        <FaIcon @icon={{@row.typeIcon}} @size="xs" />
    </div>
    <div class="min-w-0">
        <div class="flex min-w-0 items-center gap-1.5">
            <span class="truncate text-sm leading-4 text-primary" data-test-api-consumer-label>{{@row.label}}</span>
            <span class="inline-flex flex-shrink-0 items-center rounded-lg bg-surface-subtle px-1 text-[10px] leading-4 text-secondary">{{@row.typeLabel}}</span>
            {{#if @row.test_mode}}
                <span class="inline-flex flex-shrink-0 items-center rounded-lg bg-state-warning-bg border border-state-warning-border px-1 text-[10px] leading-4 text-state-warning-text">test</span>
            {{/if}}
        </div>
        {{#if (or @row.detail @row.ip)}}
            <div class="mt-0.5 truncate font-mono text-[11px] leading-4 text-muted" data-test-api-consumer-detail>
                {{@row.detail}}{{#if (and @row.detail @row.ip)}} · {{/if}}{{@row.ip}}
            </div>
        {{/if}}
    </div>
</div>