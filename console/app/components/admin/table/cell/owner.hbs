{{#if this.owner}}
    <div class="flex min-w-0 items-center gap-3">
        <Image src={{this.owner.avatar_url}} class="h-8 w-8 flex-shrink-0 rounded-full border border-default object-cover" />
        <div class="min-w-0">
            <div class="truncate text-sm font-medium text-primary">{{n-a this.owner.name}}</div>
            <div class="truncate text-xs text-muted">{{n-a this.owner.email}}</div>
            <div class="truncate text-xs text-muted">{{n-a this.owner.phone}}</div>
        </div>
    </div>
{{else}}
    <div class="flex items-center gap-2 text-xs text-state-warning-text">
        <FaIcon @icon="triangle-exclamation" />
        <span>No owner assigned</span>
    </div>
{{/if}}
