{{#if (is-array @row.oauth_providers)}}
    <div class="flex flex-wrap items-center gap-1.5">
        {{#each @row.oauth_providers as |provider|}}
            <span class="rounded border border-default bg-surface-subtle px-2 py-0.5 text-xs capitalize text-secondary" data-test-oauth-provider>{{provider}}</span>
        {{else}}
            <span class="text-xs text-muted" data-test-oauth-none>None linked</span>
        {{/each}}
    </div>
{{else}}
    <span class="text-xs text-muted" data-test-oauth-unavailable>Unavailable</span>
{{/if}}
