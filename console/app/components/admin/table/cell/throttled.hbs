{{#if @row.isThrottled}}
    <span class="inline-flex items-center gap-1 rounded-lg bg-state-danger-bg border border-state-danger-border px-1.5 text-xs font-semibold leading-5 text-state-danger-text" data-test-throttled-cell>
        <FaIcon @icon="ban" @size="xs" />
        {{@value}}
    </span>
{{else}}
    <span class="text-muted" data-test-throttled-cell>0</span>
{{/if}}