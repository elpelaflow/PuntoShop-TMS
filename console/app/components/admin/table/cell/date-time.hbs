{{#if @value}}
    <div class="leading-4" data-test-date-time-cell>
        <div class="whitespace-nowrap text-xs tabular-nums text-primary">{{@value}}</div>
        {{#if @row.lastSeenRelative}}
            <div class="text-[11px] text-muted">{{@row.lastSeenRelative}}</div>
        {{/if}}
    </div>
{{else}}
    <span class="text-muted">—</span>
{{/if}}