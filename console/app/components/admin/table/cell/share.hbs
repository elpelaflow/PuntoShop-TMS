{{! Share of all requests in the window, as a bar and a percentage. }}
<div class="flex items-center gap-2" data-test-share-cell>
    <div class="h-1.5 w-14 flex-shrink-0 overflow-hidden rounded-full bg-surface-subtle">
        <div class="h-full rounded-full bg-brand" style={{html-safe (concat "width: " (or @value 0) "%")}}></div>
    </div>
    <span class="text-xs tabular-nums text-secondary">{{or @value 0}}%</span>
</div>