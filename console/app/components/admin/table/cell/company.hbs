<div class="flex min-w-0 items-center gap-3">
    {{#if @row.logo_url}}
        <Image src={{@row.logo_url}} class="h-9 w-9 flex-shrink-0 rounded-md border border-default object-cover" />
    {{else}}
        <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-md border border-default bg-surface-subtle text-muted">
            <FaIcon @icon="building" />
        </div>
    {{/if}}
    <div class="min-w-0">
        <div class="truncate text-sm font-semibold text-primary">{{@row.name}}</div>
        <div class="truncate text-xs text-muted">{{n-a @row.description}}</div>
    </div>
</div>
