<div class="admin-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border border-default bg-surface shadow-sm" ...attributes>
    <div class="flex items-center justify-between border-b border-default px-3 py-2.5">
        <div class="flex min-w-0 items-center gap-2">
            <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md bg-state-info-bg text-state-info-text">
                <FaIcon @icon={{this.icon}} />
            </div>
            <div class="min-w-0">
                <div class="truncate text-xs font-bold uppercase text-primary">{{this.title}}</div>
                {{#if this.subtitle}}
                    <div class="truncate text-[11px] text-muted">{{this.subtitle}}</div>
                {{/if}}
            </div>
        </div>
        <button type="button" class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md text-muted hover:bg-surface-subtle hover:text-primary" {{on "click" (perform this.load)}}>
            <FaIcon @icon="rotate" />
        </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto">
        {{#if this.error}}
            <div class="flex h-full items-center justify-center p-4 text-center text-xs font-medium text-state-danger-text">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="flex h-full items-center justify-center p-4"><Spinner /></div>
        {{else if this.items.length}}
            <div class="divide-y divide-subtle">
                {{#each this.items as |item|}}
                    <button type="button" class="flex w-full items-start gap-3 px-3 py-2.5 text-left text-sm {{if item.route 'hover:bg-surface-subtle'}}" disabled={{not item.route}} {{on "click" (fn this.openItem item)}}>
                        <div class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md bg-surface-subtle text-muted">
                            <FaIcon @icon={{or item.icon "circle-info"}} />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="truncate font-medium text-primary">{{item.title}}</div>
                            {{#if item.description}}
                                <div class="truncate text-xs text-muted">{{item.description}}</div>
                            {{/if}}
                        </div>
                        {{#if item.status}}
                            <Badge @status={{item.status}} @hideStatusDot={{true}}>{{or item.value item.status}}</Badge>
                        {{else if item.value}}
                            <span class="text-xs font-semibold text-secondary">{{item.value}}</span>
                        {{/if}}
                        {{#if item.route}}
                            <FaIcon @icon="chevron-right" class="mt-1 text-[10px] text-muted" />
                        {{/if}}
                    </button>
                {{/each}}
            </div>
        {{else}}
            <div class="flex h-full items-center justify-center p-4 text-center text-xs text-muted">{{this.emptyText}}</div>
        {{/if}}
    </div>

    {{#if this.hasDrilldown}}
        <div class="border-t border-default px-3 py-2">
            <button type="button" class="inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline" {{on "click" this.openDrilldown}}>
                View all
                <FaIcon @icon="arrow-right" class="text-[10px]" />
            </button>
        </div>
    {{/if}}
</div>
