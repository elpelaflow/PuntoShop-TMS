<div class="fleetbase-blog flex h-full min-h-0 w-full" ...attributes>
    <div class="flex h-full min-h-0 w-full flex-col overflow-hidden rounded-lg border border-default bg-surface shadow-sm">
        <div class="sticky top-0 flex flex-shrink-0 flex-row items-center justify-between rounded-t-lg border-b border-default bg-surface-subtle px-4 py-2">
            <span class="text-base font-bold text-primary">Fleetbase Blog</span>
            <a href="https://www.fleetbase.io/blog" target="_blog" class="flex flex-row items-center text-sm">
                <FaIcon @icon="arrow-up-right-from-square" @size="xs" class="mr-2" />
                <span>Visit Blog</span>
            </a>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto">
            {{#if this.loadBlogPosts.isRunning}}
                <div class="p-4">
                    <Spinner />
                </div>
            {{else}}
                {{#if this.formattedPosts.length}}
                    <ul class="divide-y divide-border-default">
                        {{#each this.formattedPosts as |post|}}
                            <li class="text-sm">
                                <a
                                    href={{post.link}}
                                    target="_blog"
                                    rel="noopener noreferrer"
                                    class="group flex items-start justify-between gap-4 px-4 py-3 text-primary transition-colors hover:bg-surface-subtle hover:text-brand-hover"
                                >
                                    <span class="min-w-0 flex-1 whitespace-normal break-words font-medium leading-5">{{post.title}}</span>
                                    {{#if post.formattedDate}}
                                        <span class="flex-shrink-0 whitespace-nowrap text-right text-xs text-muted transition-colors group-hover:text-brand-hover">{{post.formattedDate}}</span>
                                    {{/if}}
                                </a>
                            </li>
                        {{/each}}
                    </ul>
                {{else}}
                    <div class="p-4 text-sm text-secondary">
                        No blog posts are available right now.
                    </div>
                {{/if}}
            {{/if}}
        </div>
    </div>
</div>
