<div class="fleetbase-github-card flex h-full min-h-0 w-full" ...attributes>
    <div class="flex h-full min-h-0 w-full flex-col overflow-hidden rounded-lg border border-default bg-surface shadow-sm">
        <div class="flex flex-shrink-0 flex-row items-center justify-between gap-3 border-b border-default px-4 py-2">
            <a href={{this.repositoryUrl}} target="_github" rel="noopener noreferrer" class="flex min-w-0 items-center gap-2 text-base font-bold text-primary hover:text-brand">
                <FaIcon @icon={{this.githubIcon}} class="flex-shrink-0 text-secondary" />
                <span class="truncate">{{or this.data.full_name "fleetbase/fleetbase"}}</span>
            </a>
            <a href={{this.repositoryUrl}} target="_github" rel="noopener noreferrer" class="btn btn-xs btn-default flex-shrink-0">
                <FaIcon @icon="star" class="text-yellow-400" />
                <span class="ml-1.5">Star</span>
            </a>
        </div>

        {{#if this.getRepositoryData.isRunning}}
            <div class="flex flex-1 items-center justify-center">
                <Spinner />
            </div>
        {{else}}
            <div class="flex min-h-0 flex-1 flex-col justify-center gap-2 px-4 py-2">
                <p class="line-clamp-2 text-sm leading-5 text-secondary">{{or this.data.description "Modular logistics and supply chain operating system."}}</p>
                <a
                    href={{this.releaseUrl}}
                    target="_github"
                    rel="noopener noreferrer"
                    class="inline-flex w-fit items-center gap-1.5 rounded-full border border-brand-subtle bg-brand-subtle px-2.5 py-0.5 font-mono text-xs font-semibold text-brand hover:opacity-80"
                >
                    <FaIcon @icon="tag" @size="xs" />
                    <span>Latest release {{this.latestRelease.name}}</span>
                </a>
            </div>

            <div class="grid flex-shrink-0 grid-cols-4 divide-x divide-subtle border-t border-default">
                {{#each this.stats as |stat|}}
                    <a href={{stat.url}} target="_github" rel="noopener noreferrer" class="flex min-w-0 items-center justify-center gap-1.5 px-2 py-2 text-xs text-secondary hover:bg-surface-subtle" title={{stat.title}}>
                        <FaIcon @icon={{stat.icon}} @size="xs" class="flex-shrink-0 text-muted" />
                        <span class="font-semibold text-primary">{{stat.value}}</span>
                        <span class="hidden truncate xl:inline">{{stat.label}}</span>
                    </a>
                {{/each}}
            </div>
        {{/if}}
    </div>
</div>
