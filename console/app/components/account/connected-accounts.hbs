{{#if this.isVisible}}
    <ContentPanel @title={{t "auth.login.oauth.connected-accounts"}} @open={{true}} @wrapperClass="bordered-classic">
        <p class="text-sm text-secondary mb-4">{{t "auth.login.oauth.connected-accounts-help"}}</p>

        {{#if this.identities.length}}
            <h4 class="text-xs font-semibold uppercase tracking-wide text-muted mb-2">{{t "auth.login.oauth.linked-heading"}}</h4>
            <div class="space-y-2" data-test-linked-providers>
                {{#each this.identities as |identity|}}
                    <div class="flex items-center justify-between rounded-md border border-default px-3 py-2">
                        <div class="flex items-center">
                            <span class="mr-3 inline-flex text-secondary">
                                <Auth::OauthProviderLogo @provider={{identity.provider}} @icon={{identity.icon}} />
                            </span>
                            <div>
                                <div class="text-sm font-semibold text-primary">{{identity.label}}</div>
                                {{#if identity.provider_email}}
                                    <div class="text-xs text-muted">{{identity.provider_email}}</div>
                                {{/if}}
                            </div>
                        </div>
                        <Button
                            @size="xs"
                            @type="danger"
                            @icon="link-slash"
                            @text={{t "auth.login.oauth.unlink-button"}}
                            @disabled={{this.isLastCredential identity}}
                            @helpText={{if (this.isLastCredential identity) (t "auth.login.oauth.errors.last-credential")}}
                            @isLoading={{this.unlink.isRunning}}
                            @onClick={{fn this.confirmUnlink identity}}
                        />
                    </div>
                {{/each}}
            </div>
        {{/if}}

        {{#if this.available.length}}
            <h4 class="text-xs font-semibold uppercase tracking-wide text-muted mb-2 {{if this.identities.length 'mt-5'}}">
                {{t "auth.login.oauth.available-heading"}}
            </h4>
            <div class="space-y-2" data-test-available-providers>
                {{#each this.available as |provider|}}
                    <div class="flex items-center justify-between rounded-md border border-dashed border-default px-3 py-2">
                        <div class="flex items-center">
                            <span class="mr-3 inline-flex text-secondary">
                                <Auth::OauthProviderLogo @provider={{provider.id}} @icon={{provider.icon}} />
                            </span>
                            <div class="text-sm text-secondary">{{provider.label}}</div>
                        </div>
                        <Button @size="xs" @icon="link" @text={{t "auth.login.oauth.link-button"}} @isLoading={{this.link.isRunning}} @onClick={{perform this.link provider}} />
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </ContentPanel>
{{/if}}