diff --git a/addon/components/radar/decision-card.js b/addon/components/radar/decision-card.js
index d09d2b1..d5adbaa 100644
--- a/addon/components/radar/decision-card.js
+++ b/addon/components/radar/decision-card.js
@@ -1,7 +1,54 @@
 import Component from '@glimmer/component';
+import { inject as service } from '@ember/service';
+import { action } from '@ember/object';
+import { localizeRadarDecisionTitle, localizeRadarDecisionSubtitle, localizeRadarDecisionButton, localizeRadarReasoning } from '../../utils/radar';
 
 export default class RadarDecisionCardComponent extends Component {
+    @service intl;
+
     get severityStatus() {
         return { critical: 'error', warning: 'warning', info: 'info' }[this.args.decision?.severity] ?? 'gray';
     }
+
+    get badgeText() {
+        const d = this.args.decision;
+        if (!d) return '';
+        const isEs = (this.intl?.primaryLocale || 'es').startsWith('es');
+        if (!isEs) return `${d.severity} · ${d.category}`;
+        const sevMap = { critical: 'crítico', warning: 'advertencia', info: 'info' };
+        const catMap = {
+            maintenance: 'Mantenimiento',
+            inspections: 'Inspecciones',
+            staffing: 'Personal',
+            compliance: 'Cumplimiento',
+            fuel: 'Combustible',
+            parts: 'Repuestos',
+            connectivity: 'Conectividad',
+            issues: 'Incidencias',
+        };
+        const sev = sevMap[d.severity] || d.severity;
+        const cat = catMap[d.category] || (this.intl?.exists(`radar.categories.${d.category}`) ? this.intl.t(`radar.categories.${d.category}`) : d.category);
+        return `${sev} · ${cat}`;
+    }
+
+    get title() {
+        return localizeRadarDecisionTitle(this.args.decision?.title, this.intl);
+    }
+
+    get subtitle() {
+        return localizeRadarDecisionSubtitle(this.args.decision?.subtitle, this.intl);
+    }
+
+    get confirmLabel() {
+        return localizeRadarDecisionButton(this.args.decision?.confirm?.label, this.intl);
+    }
+
+    @action alternativeLabel(alternative) {
+        return localizeRadarDecisionButton(alternative?.label, this.intl);
+    }
+
+    @action reasoningSegment(segment) {
+        return localizeRadarReasoning(segment?.text, this.intl);
+    }
 }
+
