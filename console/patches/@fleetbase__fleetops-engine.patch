+export function localizeRadarTitle(title, intl) {
+    if (!title || typeof title !== 'string') return title;
+    const isEs = (intl?.primaryLocale || 'es').startsWith('es');
+    if (!isEs) return title;
+
+    if (title.endsWith(' has no vehicle assigned')) {
+        return title.replace(/ has no vehicle assigned$/, ' no tiene vehículo asignado');
+    }
+    if (title.endsWith(' has no driver')) {
+        return title.replace(/ has no driver$/, ' no tiene conductor asignado');
+    }
+    if (title.endsWith(' has no tracking device')) {
+        return title.replace(/ has no tracking device$/, ' no tiene dispositivo de rastreo');
+    }
+    if (title.endsWith(' not attached to a vehicle')) {
+        return title.replace(/ not attached to a vehicle$/, ' no está asignado a un vehículo');
+    }
+    if (title.includes(' licence expired ')) {
+        return title.replace(' licence expired ', ' licencia venció el ');
+    }
+    if (title.includes(' licence expires ')) {
+        return title.replace(' licence expires ', ' licencia vence ')
+            .replace('in ', 'en ')
+            .replace('tomorrow', 'mañana')
+            .replace('today', 'hoy');
+    }
+    if (title.includes(' lease expired ')) {
+        return title.replace(' lease expired ', ' contrato venció el ');
+    }
+    if (title.includes(' lease expires ')) {
+        return title.replace(' lease expires ', ' contrato vence ')
+            .replace('in ', 'en ')
+            .replace('tomorrow', 'mañana')
+            .replace('today', 'hoy');
+    }
+    if (title.includes(' scheduled ') && title.endsWith(', not online')) {
+        return title.replace(' scheduled ', ' programado ').replace(', not online', ', desconectado');
+    }
+    if (title.includes(' on shift since ') && title.endsWith(', no vehicle assigned')) {
+        return title.replace(' on shift since ', ' en turno desde ').replace(', no vehicle assigned', ', sin vehículo asignado');
+    }
+    if (title.includes(' shift ends in ') && title.includes(' active order')) {
+        return title.replace(' shift ends in ', ' turno finaliza en ')
+            .replace(/, (\d+) active orders? still assigned/, ', $1 pedidos activos aún asignados');
+    }
+    if (title.endsWith(' failed inspection, cannot dispatch')) {
+        return title.replace(/ failed inspection, cannot dispatch$/, ' no aprobó la inspección, no se puede despachar');
+    }
+    if (title.endsWith(' link expired unused')) {
+        return title.replace(/ link expired unused$/, ' enlace venció sin usar');
+    }
+    if (title.includes(' link expires ') && title.endsWith(', not yet used')) {
+        return title.replace(' link expires ', ' enlace vence ')
+            .replace(', not yet used', ', aún sin usar')
+            .replace('in ', 'en ')
+            .replace('tomorrow', 'mañana')
+            .replace('today', 'hoy');
+    }
+    if (title.includes(' failed ') && title.includes('item')) {
+        return title.replace(/ failed (\d+) critical items?/, ' falló en $1 elementos críticos')
+            .replace(/ failed (\d+) items?/, ' falló en $1 elementos');
+    }
+    if (title.endsWith(' follow-up still open')) {
+        return title.replace(/ follow-up still open$/, ' seguimiento aún abierto');
+    }
+    if (title.includes(' started ') && title.endsWith(', never filed')) {
+        return title.replace(' started ', ' iniciado hace ').replace(', never filed', ', nunca completado');
+    }
+    if (title.endsWith(' below reorder point')) {
+        return title.replace(/ below reorder point$/, ' por debajo del punto de reorden');
+    }
+    if (title.includes(' overdue by ')) {
+        return title.replace(' overdue by ', ' vencido por ');
+    }
+    if (title.includes(' overdue ')) {
+        return title.replace(' overdue ', ' vencido hace ');
+    }
+    if (title.includes(' due in ')) {
+        return title.replace(' due in ', ' vence en ');
+    }
+    if (title.includes(' due tomorrow')) {
+        return title.replace(' due tomorrow', ' vence mañana');
+    }
+    if (title.includes(' due today')) {
+        return title.replace(' due today', ' vence hoy');
+    }
+    if (title.includes(' due ')) {
+        return title.replace(' due ', ' vence ');
+    }
+
+    return title;
+}
+
+export function localizeRadarMeta(metaLine, intl) {
+    if (!metaLine || typeof metaLine !== 'string') return metaLine;
+    const isEs = (intl?.primaryLocale || 'es').startsWith('es');
+    if (!isEs) return metaLine;
+
+    const parts = metaLine.split(' · ').map((part) => {
+        let p = part.trim();
+        if (p === 'online now') return 'en línea ahora';
+        if (p === 'online') return 'en línea';
+        if (p === 'offline') return 'desconectado';
+        if (p === 'work order open') return 'orden de trabajo abierta';
+        if (p === 'no issue') return 'sin incidencia';
+        if (p === 'no work order') return 'sin orden de trabajo';
+        if (p === 'opened, not filed') return 'abierto, sin completar';
+        if (p === 'never opened') return 'nunca abierto';
+        if (p === 'issue and work order raised') return 'incidencia y orden de trabajo creadas';
+        if (p === 'raised by an inspection') return 'generado por una inspección';
+
+        p = p.replace(/^(\d+) spare devices?$/, '$1 dispositivos disponibles');
+        p = p.replace(/^(\d+) failed$/, '$1 fallidos');
+        p = p.replace(/^(\d+)\s*mins?\s*late$/, '$1 min de retraso');
+        p = p.replace(/^(\d+)\s*hours?\s*late$/, '$1 h de retraso');
+        p = p.replace(/^(\d+)\s*days?\s*late$/, '$1 d de retraso');
+        p = p.replace(/^(\d+)\s*mins?\s*on shift$/, '$1 min en turno');
+        p = p.replace(/^(\d+)\s*hours?\s*on shift$/, '$1 h en turno');
+        p = p.replace(/^blocks (.+)$/, 'bloquea $1');
+        p = p.replace(/^reorder point (\d+)$/, 'punto de reorden $1');
+        p = p.replace(/^due at ([\d,.]+) odometer$/, 'vence a los $1 km');
+        p = p.replace(/^(\w+) priority$/, (m, prio) => {
+            const map = { critical: 'crítica', high: 'alta', urgent: 'urgente', normal: 'normal', low: 'baja' };
+            return 'prioridad ' + (map[prio] || prio);
+        });
+        p = p.replace(/^reported by (.+)$/, 'reportado por $1');
+        p = p.replace(/^raised by inspection (.+)$/, 'generado por inspección $1');
+        p = p.replace(/^lease ends (.+)$/, 'contrato termina $1');
+        p = p.replace(/^licence (.+)$/, 'licencia $1');
+        p = p.replace(/^by (.+)$/, 'por $1');
+
+        return p;
+    });
+
+    return parts.join(' · ');
+}
+
+export function localizeRadarDue(dueLabel, intl) {
+    if (!dueLabel || typeof dueLabel !== 'string') return dueLabel;
+    const isEs = (intl?.primaryLocale || 'es').startsWith('es');
+    if (!isEs) return dueLabel;
+
+    let d = dueLabel.trim();
+    if (d === 'overdue') return 'vencido';
+    if (d === 'due today' || d === 'today') return 'hoy';
+    if (d === 'due tomorrow' || d === 'tomorrow') return 'mañana';
+
+    d = d.replace(/^overdue\s*(\d+)([dhm])$/, 'vencido $1$2');
+    d = d.replace(/^due in\s*(\d+)([dhm])$/, 'en $1$2');
+
+    return d;
+}
