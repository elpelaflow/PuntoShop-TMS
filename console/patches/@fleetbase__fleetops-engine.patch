+export function localizeRadarMeta(metaLine, intl) {
+    if (!metaLine || typeof metaLine !== 'string') return metaLine;
+    const isEs = (intl?.primaryLocale || 'es').startsWith('es');
+    if (!isEs) return metaLine;
+
+    const parts = metaLine.split(' · ').map((part) => {
+        let p = part.trim();
+        if (p === 'online now') return 'en línea ahora';
+        if (p === 'online') return 'en línea';
+        if (p === 'offline') return 'desconectado';
+        if (p === 'work order open') return 'orden de trabajo abierta';
+        if (p === 'no issue') return 'sin incidencia';
+        if (p === 'no work order') return 'sin orden de trabajo';
+        if (p === 'opened, not filed') return 'abierto, sin completar';
+        if (p === 'never opened') return 'nunca abierto';
+        if (p === 'issue and work order raised') return 'incidencia y orden de trabajo creadas';
+        if (p === 'raised by an inspection') return 'generado por una inspección';
+
+        p = p.replace(/^(\d+) spare devices?$/, '$1 dispositivos disponibles');
+        p = p.replace(/^(\d+) failed$/, '$1 fallidos');
+        p = p.replace(/^(\d+)\s*mins?\s*late$/, '$1 min de retraso');
+        p = p.replace(/^(\d+)\s*hours?\s*late$/, '$1 h de retraso');
+        p = p.replace(/^(\d+)\s*days?\s*late$/, '$1 d de retraso');
+        p = p.replace(/^(\d+)\s*mins?\s*on shift$/, '$1 min en turno');
+        p = p.replace(/^(\d+)\s*hours?\s*on shift$/, '$1 h en turno');
+        p = p.replace(/^blocks (.+)$/, 'bloquea $1');
+        p = p.replace(/^reorder point (\d+)$/, 'punto de reorden $1');
+        p = p.replace(/^due at ([\d,.]+) odometer$/, 'vence a los $1 km');
+        p = p.replace(/^(\w+) priority$/, (m, prio) => {
+            const map = { critical: 'crítica', high: 'alta', urgent: 'urgente', normal: 'normal', low: 'baja' };
+            return 'prioridad ' + (map[prio] || prio);
+        });
+        p = p.replace(/^reported by (.+)$/, 'reportado por $1');
+        p = p.replace(/^raised by inspection (.+)$/, 'generado por inspección $1');
+        p = p.replace(/^lease ends (.+)$/, 'contrato termina $1');
+        p = p.replace(/^licence (.+)$/, 'licencia $1');
+        p = p.replace(/^by (.+)$/, 'por $1');
+
+        return p;
+    });
+
+    return parts.join(' · ');
+}
