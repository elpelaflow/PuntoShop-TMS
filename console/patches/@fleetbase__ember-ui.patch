+    get buttonText() {
+        if (this.args.btnText) {
+            return this.args.btnText;
+        }
+
+        const isNew = this.args.resource?.isNew ?? true;
+        if (!isNew) {
+            if (this.intl && typeof this.intl.t === 'function') {
+                try {
