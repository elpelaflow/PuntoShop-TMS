@@ -89,6 +89,36 @@ export default class ChartComponent extends Component {
             }
         }
 
+        const isPuntoShop = typeof document !== 'undefined' && document.documentElement.getAttribute('data-palette') === 'puntoshop';
+        if (isPuntoShop && Array.isArray(options.data.datasets)) {
+            const remapColor = (color) => {
+                if (typeof color === 'string') {
+                    return color
+                        .replace(/rgba?\(37,\s*99,\s*235/g, 'rgba(214, 28, 34')
+                        .replace(/rgba?\(52,\s*133,\s*226/g, 'rgba(214, 28, 34')
+                        .replace(/rgba?\(59,\s*130,\s*246/g, 'rgba(214, 28, 34')
+                        .replace(/#2563eb/gi, '#d61c22')
+                        .replace(/#3485e2/gi, '#d61c22')
+                        .replace(/#3b82f6/gi, '#d61c22');
+                }
+                if (Array.isArray(color)) {
+                    return color.map(remapColor);
+                }
+                return color;
+            };
+
+            options.data.datasets = options.data.datasets.map((ds) => {
+                const updated = { ...ds };
+                if (updated.backgroundColor) {
+                    updated.backgroundColor = remapColor(updated.backgroundColor);
+                }
+                if (updated.borderColor) {
+                    updated.borderColor = remapColor(updated.borderColor);
+                }
+                return updated;
+            });
+        }
+
         this.useDateFns();
         this.chart = new Chart(ctx, options);
     }
